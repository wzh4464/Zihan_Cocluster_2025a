// tasks.json
{
  "version": "2.0.0",
  "tasks": [
    // run make
    {
      "label": "make",
      "type": "shell",
      "command": "make",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    // arara with verbose output
    {
      "label": "arara -v root",
      "type": "shell",
      "command": "arara",
      "args": ["-v", "root"],
      "group": "build"
    },
    // arara compile root
    {
      "label": "arara root",
      "type": "shell",
      "command": "arara",
      "args": ["root"],
      "group": "build"
    }
  ]
}
